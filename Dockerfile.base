# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────
# BASE IMAGE — contains all heavy conda + pip dependencies.
# This image is pre-built and pushed to GHCR; it only needs to be
# rebuilt when environment.yml or the git-pinned packages change.
# Build & push via the .github/workflows/build-base.yml workflow.
# ─────────────────────────────────────────────────────────────────
FROM mambaorg/micromamba:1.5.10

# Install system deps as root
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
 && rm -rf /var/lib/apt/lists/*

# Switch back to mamba user for all env operations
USER $MAMBA_USER

# Install conda packages
COPY --chown=$MAMBA_USER:$MAMBA_USER environment.yml /tmp/environment.yml
RUN micromamba install -y -n base -f /tmp/environment.yml && \
    micromamba clean --all --yes

# Activate base env for subsequent RUN commands
ARG MAMBA_DOCKERFILE_ACTIVATE=1

# Install git-based packages via pip
RUN pip install --no-cache-dir \
    "git+https://github.com/RDFLib/rdflib-sqlalchemy.git@develop" \
    "git+https://github.com/pyscal/atomRDF.git@clean_structure" \
    "git+https://github.com/OCDO/tools4RDF.git@main"

# Patch rdflib_sqlalchemy to use importlib.metadata instead of legacy pkg_resources
RUN python - <<'EOF'
import rdflib_sqlalchemy, os
path = os.path.join(os.path.dirname(rdflib_sqlalchemy.__file__), '__init__.py')
src = open(path).read()
src = src.replace(
    'from pkg_resources import get_distribution',
    'from importlib.metadata import distribution as get_distribution'
)
src = src.replace(
    'get_distribution("rdflib_sqlalchemy").version',
    'get_distribution("rdflib_sqlalchemy").metadata["Version"]'
)
open(path, 'w').write(src)
print("Patched", path)
EOF
