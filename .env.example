# Copy to .env and fill in your values before deploying
# This file is checked into git — NEVER put secrets here directly

# Secret token for the /api/admin/reload endpoint
# Generate with: openssl rand -hex 32
RELOAD_TOKEN=changeme

# Path to kg_data on the host VM (used by docker-compose volume mount)
KG_DATA_DIR=/home/opc/kg_data

# LLM for natural-language -> SPARQL. An empty key disables only that feature.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
